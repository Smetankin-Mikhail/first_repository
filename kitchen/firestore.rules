rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Данные семьи лежат в families/<ключ из ссылки>/...
    // Список всех семей получить нельзя: без ключа из ссылки данные не найти.
    match /families/{fam}/{col}/{doc} {
      function allowed() {
        return fam.size() >= 24 && col in ['have', 'fridge', 'ratings', 'plan', 'recipes', 'extra'];
      }
      allow get, list, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.size() <= 6
        && (!('json' in request.resource.data) || request.resource.data.json.size() < 60000);
    }
  }
}
