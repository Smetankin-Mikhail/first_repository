rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ только у Google-аккаунтов из списка. Настоящие почты вписаны в консоли Firebase,
    // в репозитории вместо них заглушки.
    function member() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['OWNER@gmail.com', 'PARTNER@gmail.com'];
    }
    match /families/{fam}/{col}/{doc} {
      function allowed() {
        return member() && col in ['have', 'fridge', 'ratings', 'plan', 'recipes', 'extra'];
      }
      allow get, list, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.size() <= 6
        && (!('json' in request.resource.data) || request.resource.data.json.size() < 60000);
    }
    // Ключ к калориям и нормам: читают оба, записывает только владелец.
    match /keys/{id} {
      allow read: if member();
      allow write: if member() && request.auth.token.email == 'OWNER@gmail.com';
    }
  }
}
